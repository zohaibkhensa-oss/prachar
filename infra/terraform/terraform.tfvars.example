# Prachar AI — Terraform variables example
# Copy to terraform.tfvars or use -var-file
#
# For dev/staging:  terraform apply -var-file="terraform.tfvars.dev"
# For production:    terraform apply -var-file="terraform.tfvars.prod"

aws_region     = "ap-southeast-2"
project_name   = "prachar"
environment    = "staging"
domain_name    = "curvai.org"
api_domain     = "api.curvai.org"
app_domain     = "app.curvai.org"

# Database
db_instance_class    = "db.t3.micro"
db_multi_az          = false
db_allocated_storage = 20

# Redis
redis_node_type    = "cache.t3.micro"
redis_cluster_size = 0

# ECS
ecs_api_cpu        = 512
ecs_api_memory     = 1024
api_desired_count  = 1
worker_desired_count = 1
worker_cpu         = 512
worker_memory      = 1024

# WAF
enable_waf = false

# NAT
enable_nat_single_az = true

# Alerts — set your email to receive CloudWatch alarm notifications
alert_email = ""

# ECR images (fill after first build+push)
ecr_api_image    = ""
ecr_web_image    = ""
ecr_worker_image = ""
