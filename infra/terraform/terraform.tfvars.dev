# Dev/Staging Terraform variables — minimal cost configuration
# Usage: terraform apply -var-file="terraform.tfvars.dev"

aws_region     = "ap-southeast-2"
project_name   = "prachar"
environment    = "staging"
domain_name    = "curvai.org"
api_domain     = "api.curvai.org"
app_domain     = "app.curvai.org"

# Database — single AZ, small instance, minimal storage
db_instance_class    = "db.t3.micro"
db_multi_az          = false
db_allocated_storage = 20

# Redis — single node, small instance
redis_node_type    = "cache.t3.micro"
redis_cluster_size = 0

# ECS — single API + single worker
ecs_api_cpu        = 512
ecs_api_memory     = 1024
api_desired_count  = 1
worker_desired_count = 1
worker_cpu         = 512
worker_memory      = 1024

# Disable WAF for dev/staging (saves ~$10/mo)
enable_waf = false

# Single NAT gateway (saves ~$35/mo)
enable_nat_single_az = true

# ECR images (fill after first build+push)
ecr_api_image    = ""
ecr_web_image    = ""
ecr_worker_image = ""
