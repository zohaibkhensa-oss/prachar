# ─── Core ────────────────────────────────────────────────────────────────────
APP_ENV=local
APP_NAME=prachar
LOG_LEVEL=INFO
# async postgres (SQLAlchemy 2 async)
DATABASE_URL=postgresql+asyncpg://prachar:prachar@localhost:5432/prachar
# sync url for alembic
DATABASE_URL_SYNC=postgresql+psycopg://prachar:prachar@localhost:5432/prachar
REDIS_URL=redis://localhost:6379/0
# generate w/ `openssl rand -hex 32`
JWT_SECRET=change-me-jwt
JWT_REFRESH_SECRET=change-me-refresh
JWT_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
# AES-GCM key for OAuth token at-rest encryption (32 bytes hex)
TOKEN_ENC_KEY=change-me-32-byte-hex-key-please

# ─── S3 / object store ───────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=prachar
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_REGION=us-east-1

# ─── AI gateway ──────────────────────────────────────────────────────────────
# Leave blank to run in STUB mode (no real LLM calls; deterministic fake outputs)
# Supported providers: groq, anthropic, openai (Groq is fastest & free tier)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
AI_DEFAULT_PROVIDER=groq
AI_SMALL_MODEL=llama-3.3-70b-versatile
AI_LARGE_MODEL=llama-3.3-70b-versatile
AI_BUDGET_STARTER_INR=100
AI_BUDGET_GROWTH_INR=1000
AI_BUDGET_AGENCY_INR=10000

# ─── Billing ─────────────────────────────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Channel OAuth (organic) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
TELEGRAM_BOT_TOKEN=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
KAKAO_REST_API_KEY=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ─── Ads networks ────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
META_ADS_APP_ID=
META_ADS_APP_SECRET=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=
LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=
X_ADS_CLIENT_ID=
X_ADS_CLIENT_SECRET=

# ─── SERP / crawl helpers ────────────────────────────────────────────────────
SERP_API_KEY=
PAGE_SPEED_API_KEY=

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
